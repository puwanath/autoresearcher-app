# LLM (vLLM, OpenAI-compatible)
VLLM_ENDPOINT=http://192.168.3.238:8000/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=Qwen3.6-35B-A3B-FP8
VLLM_TEMPERATURE=0.3
VLLM_MAX_TOKENS=8192
VLLM_TOP_P=0.9
VLLM_TIMEOUT=240
# Qwen3 thinks by default; keep off for structured extraction, enable for analysis if desired
VLLM_ENABLE_THINKING=false

# Database / queue (host ports — see docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://autoresearch:autoresearch@localhost:5433/autoresearch
REDIS_URL=redis://localhost:6380/0

# Research limits
SEARCH_REGION=th-th
MAX_SEARCH_RESULTS=8
MAX_PAGES=12
MAX_ITERATIONS=2
SCRAPE_TIMEOUT=20
USE_PLAYWRIGHT=true

# Storage (MinIO arrives in Phase 2; Phase 1 writes to local disk)
DATA_DIR=./data
